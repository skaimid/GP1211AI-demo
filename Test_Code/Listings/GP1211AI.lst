 427          void Spi_Init(void)
 428          {
 429   1          // |SPCTL ||| SSIG | SPEN | DORD | MSTR | CPOL | CPHA | SPR[1:0] |
 430   1          // |      |||   1  |   1  |   1  |   1  |   0  |   0  |   11     |
 431   1          //SPR -- 00--/4, 01--/8 , 10--/16 , 11--/2
 432   1          SPCTL = 0xf0;
 433   1          // |SPSTAT||| SPIF | WCOL |  NC  |  NC  |  NC  |  NC  |  NC  |
 434   1          //clear flags
 435   1          SPSTAT = 0xc0;
