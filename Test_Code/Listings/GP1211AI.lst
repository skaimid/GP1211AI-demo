 333          
 334          //Timer0 used for VFD refresh
 335          void Timer_0_Svr(void) interrupt 1
 336          {
 337   1              unsigned char cycle_cnt = 48;
 338   1              if(VFD_GRID_SCAN==0)
 339   1              {
 340   2                      DP_BUF_POINT  = DP_BUF;
 341   2                      VFD_GRID_SCAN = 43;
 342   2                      
 343   2                      VFD_SIG=1;
 344   2                      VFD_CLKG_STROBE();
 345   2                      VFD_CLKG_STROBE();
 346   2                      VFD_SIG=0;
 347   2                      VFD_CLKG_STROBE();
 348   2                      VFD_CLKG_STROBE();
 349   2                      VFD_CLKG_STROBE();
 350   2              }
 351   1              
 352   1          while((cycle_cnt--)>0)
 353   1              {       
 354   2                      SPDAT = *DP_BUF_POINT++;                //write data to send buffer
 355   2                      while (!(SPSTAT&0x80)); 
 356   2              SPSTAT = 0xc0; 
 357   2              }
 358   1              VFD_CLKG_STROBE();              
 359   1              PWMB_CCR6  = 0; 
 360   1              VFD_LAT_STROBE();
 361   1              PWMB_CCR6  = Disp_Brt_Data; //Disp_Brt_Data;VFD_BK=0;
 362   1              --VFD_GRID_SCAN;
 363   1      }
