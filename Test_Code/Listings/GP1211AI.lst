 247          //Display a 12*24 dots ASCII charactor at position (VFD_X,VFD_Y) , location by dot
 248          void VFD_DISP_ASC1224(unsigned char VFD_X,unsigned char VFD_Y,unsigned char DAT)
 249          {
 250   1              unsigned char i;
 251   1              for(i=0;i<12;i++)
 252   1              {
