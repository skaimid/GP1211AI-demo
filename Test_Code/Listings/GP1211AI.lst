 390          void Port_Switch(void)
 391          {
 392   1          //| P_SW1 | addr | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
 393   1          //|                   | A2H  | S1_S  | - | - | SPI_S | 0 | - |
 394   1          //| set value    | 0 | 0 | 0 | 0 | 0 | 1 | 0 | 0 |
 395   1          //uart 1 using P3.0 and P3.1 , spi using P2.2 P2.3 P2.4 P2.5
 396   1          P_SW1 = 0x04;       
 397   1      
 398   1          //| P_SW2 | addr |   7   | 6 | 5 | 4 |    3   |   2  |   1  |   0  |
 399   1          //|       | BAH  | EAXFR | - | I2C_S | CMPO_S | S4_S | S3_S | S2_S |
 400   1          //| set value    |   1   | 0 | 0 | 0 |    0   |   1  |   1  |   1  |
 401   1          //uart 4 using P5.2 P5.3 , uart 3 using P5.0 P5.1 , uart 2 using P4.6 P4.7
 402   1          //P_SW2 = 0x87;
 403   1      
 404   1          //| PWMB_PS | addr | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
 405   1          //|         | feb6 |  C8PS |  C7PS |  C6PS |  C5PS |
 406   1          //| set valude     | 0 | 0 | 0 | 0 | 1 | 1 | 1 | 1 |
 407   1          //PWM5 switched to P7.4 , PWM6 switched to P7.5
 408   1          //PWMB_PS = 0x0f;
 409   1      }
 410          
 411          void Pwm_Init(void)
 412          {
 413   1              P_SW2 |= 0x80;
 414   1          PWMB_CCER1 = 0x00;                          //写CCMRx前必须先清零CCERx关闭通道
 415   1          PWMB_CCMR1 = 0x60;                          //设置CC5为PWMA输出模式
 416   1              PWMB_CCMR2 = 0x70;                                                      //设置CC6为PWMA输出模式 
 417   1          PWMB_CCER1 = 0x11;                          //使能CC6 CC5通道
 418   1          PWMB_CCR5  = Disp_Brt_Data;                 //设置占空比时间
 419   1              PWMB_CCR6  = Disp_Brt_Data;                 //设置占空比时间
 420   1          PWM2_PSCR  = 2; 
 421   1          PWMB_ARR = 200;                             //设置周期时间
 422   1          PWMB_ENO = 0x05;                            //使能PWM6 PWM5端口输出
 423   1          PWMB_BKR = 0x80;                            //使能主输出
 424   1          PWMB_CR1 = 0x01;                            //开始计时
 425   1      }
