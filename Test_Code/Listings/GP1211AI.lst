 207          //Display a 5*7 dots ASCII charactor at position (VFD_X,VFD_Y)
 208          void VFD_DISP_ASC57(unsigned char VFD_X,unsigned char VFD_Y,unsigned char DAT)
 209          {
 210   1              unsigned char i;
 211   1              for(i=0;i<5;i++)
 212   1              {
 213   2                      DP_RAM[VFD_X][VFD_Y*8+i] = ASC57[((DAT-0x20)*5)+i];
 214   2              }
 215   1      }
 216          
 217          //Display 5*7 dots ASCII charactor string started at position (VFD_X,VFD_Y)
 218          void VFD_DISP_ASC57_STR(unsigned char VFD_X,unsigned char VFD_Y,unsigned char *STR)
 219          {
 220   1              while(*STR)
 221   1              {
 222   2                      VFD_DISP_ASC57(VFD_X,VFD_Y++,*STR++);
 223   2              }
 224   1      }
