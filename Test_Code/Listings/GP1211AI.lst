 370          void Gpio_Init(void)
 371          {
 372   1          //0.4 0.7push pull , others standard
 373   1          P0M0 = 0x03; P0M1 = 0x00; 
 374   1          //1.0~1 standard , 1.2 push pull , 1.3~5 standard , 1.6~7push-pull 
 375   1          P1M0 = 0x00; P1M1 = 0x00; 
 376   1          //2.0~3 5~7 push-pull , 2.4 standard
 377   1          P2M0 = 0x00; P2M1 = 0x00; //P2PU = 0x00; P2SR = 0x00;
 378   1          //3.0~2 standard , 3.3~7 push-pull
 379   1          P3M0 = 0x00; P3M1 = 0x00;
 380   1          //4.1~4 push pull , others standard
 381   1          P4M0 = 0x00; P4M1 = 0x00; 
 382   1          //5.4 push pull , others standard
 383   1          P5M0 = 0x00; P5M1 = 0x00;
 384   1          //6.7~5 push pull , others standard
 385   1          P6M0 = 0x00; P6M1 = 0x00;
 386   1          //7.0~5 pull pull , others standard
 387   1          P7M0 = 0x00; P7M1 = 0x00;
 388   1      }
